# MyDesk WhatsApp gateway (Evolution API v2.3.7). Copy to .env (git-ignored) or run setup.sh.

# --- Server
SERVER_TYPE=http
SERVER_PORT=8080
# Address Chatwoot uses for the inbox webhook; must be reachable from the sidekiq container
SERVER_URL=http://evolution-api:8080
CORS_ORIGIN=*
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=false
DEL_INSTANCE=false
LANGUAGE=en
TELEMETRY_ENABLED=false
WEBSOCKET_ENABLED=false

# --- Global API key (manager login and admin API calls); setup.sh generates one
AUTHENTICATION_API_KEY=change-me
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# --- Storage: its own database on Chatwoot's Postgres server
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:@postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=mydesk_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# --- Cache: a separate Redis database index from Chatwoot's
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://:@redis:6379/6
CACHE_REDIS_PREFIX_KEY=mydesk_evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# --- WhatsApp session
CONFIG_SESSION_PHONE_CLIENT=MyDesk
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# --- Chatwoot integration
CHATWOOT_ENABLED=true
CHATWOOT_MESSAGE_READ=true
CHATWOOT_MESSAGE_DELETE=true
CHATWOOT_BOT_CONTACT=false
CHATWOOT_IMPORT_PLACEHOLDER_MEDIA_MESSAGE=true
